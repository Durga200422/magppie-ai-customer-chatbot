# Environment secrets — NEVER commit to version control
.env
.streamlit/secrets.toml

# Vector database
# NOTE: chroma_db/ is intentionally committed to the repo so that Streamlit Cloud
# can serve the chatbot immediately without rebuilding the knowledge base on every cold start.
# Uncomment the line below only if you want to exclude it (e.g. to trigger an auto-rebuild).
# chroma_db/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Runtime / build artifacts
leads/
logs/

# Virtual environment
venv/
.venv/
env/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
